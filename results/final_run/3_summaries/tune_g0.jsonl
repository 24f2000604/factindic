{"item": "hi:xlsum:051009_uri_altaf|roman", "uid": "hi:xlsum:051009_uri_altaf", "lang": "hi", "variant": "roman", "system": "tune_g0", "method": "anchor_cad_dola", "params": {"alpha_base": 0.4, "alpha_anchor": 0.9, "beta": 0.2, "eta": 0.1, "static_alpha": 0.5, "max_new_tokens": 160}, "summary": "उड़ी में लोगों से बात करते हुए पता चला कि शनिवार की रात बारिश और ठंड में खुले में बिताई गई। लगामा गाँव नष्ट हो गया और कमलगई गाँव लगभग नष्ट हो गया, जहाँ 700 लोगों की मौत हुई। बच्चों को खाने को कुछ नहीं मिला।", "mean_alpha": 0.5186437964439392, "dola_layers": [12, 15, 19, 22], "latency_s": 0.8749117479998555, "latency_mode": "batch6", "precision": "bf16, per-layer embeddings on the CPU", "input_fertility": 1.5914285714285714, "sum_tokens": 58, "sum_words": 46, "peak_vram_gb": 5.698131456}
