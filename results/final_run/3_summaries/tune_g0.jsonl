{"item": "hi:xlsum:040106_saarc_reaction|roman", "uid": "hi:xlsum:040106_saarc_reaction", "lang": "hi", "variant": "roman", "system": "tune_g0", "method": "anchor_cad_dola", "params": {"alpha_base": 0.4, "alpha_anchor": 0.9, "beta": 0.2, "eta": 0.1, "static_alpha": 0.5, "max_new_tokens": 160}, "summary": "संयुक्त राष्ट्र महासचिव कोफ़ी अन्नान ने भारत-पाकिस्तान बातचीत की सराहना की; अमेरिका, ब्रिटेन, जापान और जर्मनी सहित कई देशों ने इसका स्वागत किया।", "mean_alpha": 0.5406247973442078, "dola_layers": [12, 15, 19, 22], "latency_s": 0.8749117479998555, "latency_mode": "batch6", "precision": "bf16, per-layer embeddings on the CPU", "input_fertility": 1.7485714285714287, "sum_tokens": 31, "sum_words": 23, "peak_vram_gb": 5.698131456}
