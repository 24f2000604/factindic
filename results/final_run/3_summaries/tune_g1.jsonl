{"item": "hi:xlsum:080425_china_dalai_talks|roman", "uid": "hi:xlsum:080425_china_dalai_talks", "lang": "hi", "variant": "roman", "system": "tune_g1", "method": "anchor_cad_dola", "params": {"alpha_base": 0.2, "alpha_anchor": 0.6, "beta": 0.2, "eta": 0.1, "static_alpha": 0.5, "max_new_tokens": 160}, "summary": "दलाई लामा के प्रवक्ता तेनज़िन ताकला ने चीन के साथ बातचीत शुरू करने की पहल का स्वागत किया। चीन सरकार बातचीत शुरू करने की इच्छा व्यक्त कर रही है।", "mean_alpha": 0.32631567120552063, "dola_layers": [12, 15, 19, 22], "latency_s": 0.8167163738332116, "latency_mode": "batch6", "precision": "bf16, per-layer embeddings on the CPU", "input_fertility": 1.5685714285714285, "sum_tokens": 37, "sum_words": 29, "peak_vram_gb": 5.698131456}
{"item": "hi:xlsum:040106_saarc_reaction|roman", "uid": "hi:xlsum:040106_saarc_reaction", "lang": "hi", "variant": "roman", "system": "tune_g1", "method": "anchor_cad_dola", "params": {"alpha_base": 0.2, "alpha_anchor": 0.6, "beta": 0.2, "eta": 0.1, "static_alpha": 0.5, "max_new_tokens": 160}, "summary": "संयुक्त राष्ट्र महासचिव कोफ़ी अन्नान ने भारत-पाकिस्तान बातचीत की सराहना की; अमेरिका और ब्रिटेन ने इसका स्वागत किया।", "mean_alpha": 0.3119998872280121, "dola_layers": [12, 15, 19, 22], "latency_s": 0.8167163738332116, "latency_mode": "batch6", "precision": "bf16, per-layer embeddings on the CPU", "input_fertility": 1.7485714285714287, "sum_tokens": 24, "sum_words": 18, "peak_vram_gb": 5.698131456}
{"item": "hi:xlsum:magazine-40548061|roman", "uid": "hi:xlsum:magazine-40548061", "lang": "hi", "variant": "roman", "system": "tune_g1", "method": "anchor_cad_dola", "params": {"alpha_base": 0.2, "alpha_anchor": 0.6, "beta": 0.2, "eta": 0.1, "static_alpha": 0.5, "max_new_tokens": 160}, "summary": "सोवियत संघ के लोगों को अमेरिका से खुलकर बातचीत का पहला मौका लेनिनग्राद और बोस्टन में हुआ था। गोर्बाचोफ़ के शासन में यह संवाद हुआ, जहाँ सांस्कृतिक मतभेद थे। एक अमेरिकी महिला के सवाल ने कार्यक्रम में तनाव पैदा कर दिया।", "mean_alpha": 0.3103449046611786, "dola_layers": [12, 15, 19, 22], "latency_s": 0.8167163738332116, "latency_mode": "batch6", "precision": "bf16, per-layer embeddings on the CPU", "input_fertility": 1.677142857142857, "sum_tokens": 57, "sum_words": 41, "peak_vram_gb": 5.698131456}
{"item": "hi:xlsum:051009_uri_altaf|roman", "uid": "hi:xlsum:051009_uri_altaf", "lang": "hi", "variant": "roman", "system": "tune_g1", "method": "anchor_cad_dola", "params": {"alpha_base": 0.2, "alpha_anchor": 0.6, "beta": 0.2, "eta": 0.1, "static_alpha": 0.5, "max_new_tokens": 160}, "summary": "उड़ी में लोगों से बात करते हुए पता चला कि बारिश और ठंड में खुले में बिताई गई रातें हैं। लगामा गाँव नष्ट हो गया और कमलगई गाँव लगभग नष्ट हो गया है, जहाँ 700 लोगों की मौत हुई।", "mean_alpha": 0.29999998211860657, "dola_layers": [12, 15, 19, 22], "latency_s": 0.8167163738332116, "latency_mode": "batch6", "precision": "bf16, per-layer embeddings on the CPU", "input_fertility": 1.5914285714285714, "sum_tokens": 51, "sum_words": 39, "peak_vram_gb": 5.698131456}
