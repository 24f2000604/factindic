{"item": "hi:xlsum:130120_international_pakistan_death_inquiry_vd|roman", "uid": "hi:xlsum:130120_international_pakistan_death_inquiry_vd", "lang": "hi", "variant": "roman", "system": "tune_g1", "method": "anchor_cad_dola", "params": {"alpha_base": 0.2, "alpha_anchor": 0.6, "beta": 0.2, "eta": 0.1, "static_alpha": 0.5, "max_new_tokens": 160}, "summary": "प्रधान मंत्री राजा परवेज़ अशरफ़ पर भ्रष्टाचार के आरोप लगे। कामरान फ़ैसल की मौत की जाँच हो रही है, जिसमें हत्या की संभावना भी है।", "mean_alpha": 0.3666665852069855, "dola_layers": [12, 15, 19, 22], "latency_s": 0.8167163738332116, "latency_mode": "batch6", "precision": "bf16, per-layer embeddings on the CPU", "input_fertility": 1.7372549019607844, "sum_tokens": 35, "sum_words": 25, "peak_vram_gb": 5.698131456}
